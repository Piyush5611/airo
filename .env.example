# MySQL — set these locally. Never commit .env.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# App
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional. When empty, credential encryption is derived from JWT_SECRET.
CREDENTIALS_KEY=

# Must match the verify token typed in the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=
META_VERIFY_TOKEN=

# Meta "Connect with Facebook". App id and secret come from the AIRO Meta app (App settings → Basic).
# META_LOGIN_CONFIG_ID is a Facebook Login for Business configuration; with a "System-user access token"
# configuration the token does not expire. Valid OAuth redirect URI must be META_OAUTH_REDIRECT_URI,
# or CLIENT_ORIGIN + /api/meta-ads/callback when that is empty.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=

# Google Ads. The developer token comes from the AIRO manager account (API Center).
# The OAuth client is a Google Cloud "Web application" client. Its authorized redirect URI must be
# GOOGLE_OAUTH_REDIRECT_URI, or CLIENT_ORIGIN + /api/google-ads/callback when that is empty.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_ADS_API_VERSION=

# Development seed only. Not used in production.
# Quote the value if it contains #, otherwise dotenv treats the rest as a comment.
SEED_PASSWORD=
