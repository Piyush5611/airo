# MySQL — set these locally. Never commit .env.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# App
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional. When empty, credential encryption is derived from JWT_SECRET.
CREDENTIALS_KEY=

# Development seed only. Not used in production.
# Quote the value if it contains #, otherwise dotenv treats the rest as a comment.
SEED_PASSWORD=
